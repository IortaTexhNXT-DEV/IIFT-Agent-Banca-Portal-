// IIFT Agent/Banca Portal & Back-office — relational data model.
// Table and column names are snake_case in PostgreSQL; model fields are camelCase in code.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enumerations
// ---------------------------------------------------------------------------

enum UserType {
  AGENT
  BANCA
  STAFF
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum AuthSource {
  LOCAL
  DIRECTORY
}

enum Audience {
  PORTAL
  BACKOFFICE
}

enum Channel {
  AGENCY
  BANCA
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AgentType {
  MAIN_AGENT
  SUB_AGENT
  BANKER
}

enum AgentStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
  REJECTED
}

enum IdType {
  NRIC
  PASSPORT
  BUSINESS_REG
}

enum ParticipantType {
  INDIVIDUAL
  CORPORATE
}

enum AmlStatus {
  NOT_SCREENED
  CLEAR
  FLAGGED
  REJECTED
}

enum AmlCaseStatus {
  AUTO_CLEARED
  PENDING_REVIEW
  CLEARED
  CONFIRMED_MATCH
}

enum PolicyStatus {
  DRAFT
  PENDING_APPROVAL
  PENDING_PAYMENT
  ACTIVE
  REJECTED
  EXPIRED
  CANCELLED
}

enum PolicyPaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
}

enum NomineeRole {
  NOMINEE
  BENEFICIARY
  EXECUTOR
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH_DEPOSIT
  ONLINE
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  ACKNOWLEDGED
  REJECTED
  CLOSED
}

enum DocumentOwnerType {
  AGENT
  AGENCY
  PARTICIPANT
  POLICY
  PAYMENT
  CLAIM
  ISSUE
  REPORT
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ApprovalType {
  AGENT_REGISTRATION
  AGENT_PROFILE_UPDATE
  AGENT_STATUS_CHANGE
  PARTICIPANT_UPDATE
  POLICY_REFERRAL
  POLICY_ENDORSEMENT
  POLICY_CANCELLATION
  PAYMENT_VERIFICATION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApprovalActionType {
  SUBMIT
  APPROVE
  REJECT
  WITHDRAW
}

enum IssuePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum IntegrationSystem {
  CORE
  FINANCE
  AML
  EMAIL
  SMS
  DIRECTORY
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

enum IntegrationDirection {
  OUTBOUND
  INBOUND
}

enum JobStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationStatus {
  MATCHED
  MISMATCH
}

enum ParameterType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ExportFormat {
  XLSX
  CSV
  PDF
}

enum CommissionStatus {
  ACCRUED
  PAID
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @unique @db.VarChar(64)
  email              String     @db.VarChar(254)
  fullName           String     @map("full_name") @db.VarChar(150)
  mobile             String?    @db.VarChar(20)
  userType           UserType   @map("user_type")
  status             UserStatus @default(ACTIVE)
  authSource         AuthSource @default(LOCAL) @map("auth_source")
  passwordHash       String?    @map("password_hash")
  passwordChangedAt  DateTime?  @map("password_changed_at")
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until")
  lastLoginAt        DateTime?  @map("last_login_at")
  agentId            String?    @unique @map("agent_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  agent           Agent?            @relation(fields: [agentId], references: [id])
  roles           UserRole[]
  passwordHistory PasswordHistory[]
  notifications   Notification[]

  @@index([userType, status])
  @@map("app_user")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  audience    Audience
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String @db.VarChar(80)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

// Server-side HTTP sessions (managed by connect-pg-simple).
model UserSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("user_session")
}

// ---------------------------------------------------------------------------
// Agency / Banca and agents
// ---------------------------------------------------------------------------

model Agency {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique @db.VarChar(20)
  name                String       @db.VarChar(150)
  channel             Channel
  registrationNo      String?      @map("registration_no") @db.VarChar(50)
  email               String?      @db.VarChar(254)
  phone               String?      @db.VarChar(20)
  address             String?      @db.VarChar(300)
  status              AgencyStatus @default(ACTIVE)
  issuanceBlocked     Boolean      @default(false) @map("issuance_blocked")
  issuanceBlockedAt   DateTime?    @map("issuance_blocked_at")
  issuanceBlockReason String?      @map("issuance_block_reason") @db.VarChar(300)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  agents   Agent[]
  policies Policy[]
  payments Payment[]

  @@map("agency")
}

model Agent {
  id             String      @id @default(uuid()) @db.Uuid
  agentCode      String      @unique @map("agent_code") @db.VarChar(20)
  agencyId       String      @map("agency_id") @db.Uuid
  agentType      AgentType   @map("agent_type")
  parentAgentId  String?     @map("parent_agent_id") @db.Uuid
  fullName       String      @map("full_name") @db.VarChar(150)
  idType         IdType      @map("id_type")
  idNumberEnc    String      @map("id_number_enc")
  idNumberHash   String      @map("id_number_hash") @db.VarChar(64)
  dateOfBirth    DateTime?   @map("date_of_birth") @db.Date
  email          String      @db.VarChar(254)
  mobile         String      @db.VarChar(20)
  address        String?     @db.VarChar(300)
  branchName     String?     @map("branch_name") @db.VarChar(100)
  licenceNo      String?     @map("licence_no") @db.VarChar(50)
  licenceExpiry  DateTime?   @map("licence_expiry") @db.Date
  status         AgentStatus @default(PENDING)
  statusReason   String?     @map("status_reason") @db.VarChar(300)
  amlStatus      AmlStatus   @default(NOT_SCREENED) @map("aml_status")
  authorityLimit Decimal?    @map("authority_limit") @db.Decimal(14, 2)
  activatedAt    DateTime?   @map("activated_at")
  terminatedAt   DateTime?   @map("terminated_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  version        Int         @default(0)

  agency      Agency       @relation(fields: [agencyId], references: [id])
  parent      Agent?       @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  subAgents   Agent[]      @relation("AgentHierarchy")
  user        User?
  policies    Policy[]
  commissions Commission[]

  @@unique([idType, idNumberHash])
  @@index([agencyId, status])
  @@index([parentAgentId])
  @@map("agent")
}

// ---------------------------------------------------------------------------
// Participants and AML/KYC
// ---------------------------------------------------------------------------

model Participant {
  id                String          @id @default(uuid()) @db.Uuid
  participantNo     String          @unique @map("participant_no") @db.VarChar(20)
  type              ParticipantType
  fullName          String          @map("full_name") @db.VarChar(150)
  idType            IdType          @map("id_type")
  idNumberEnc       String          @map("id_number_enc")
  idNumberHash      String          @map("id_number_hash") @db.VarChar(64)
  dateOfBirth       DateTime?       @map("date_of_birth") @db.Date
  gender            String?         @db.VarChar(10)
  nationality       String?         @db.VarChar(50)
  occupation        String?         @db.VarChar(100)
  occupationClass   Int?            @map("occupation_class")
  email             String?         @db.VarChar(254)
  mobile            String          @db.VarChar(20)
  addressLine1      String          @map("address_line1") @db.VarChar(200)
  addressLine2      String?         @map("address_line2") @db.VarChar(200)
  postcode          String?         @db.VarChar(10)
  district          String?         @db.VarChar(50)
  contactPerson     String?         @map("contact_person") @db.VarChar(150)
  amlStatus         AmlStatus       @default(NOT_SCREENED) @map("aml_status")
  amlScreenedAt     DateTime?       @map("aml_screened_at")
  createdByAgentId  String?         @map("created_by_agent_id") @db.Uuid
  createdByAgencyId String?         @map("created_by_agency_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  version           Int             @default(0)

  policies Policy[]

  @@unique([idType, idNumberHash])
  @@index([fullName])
  @@index([createdByAgencyId])
  @@map("participant")
}

model AmlScreening {
  id            String        @id @default(uuid()) @db.Uuid
  subjectType   String        @map("subject_type") @db.VarChar(20)
  subjectId     String        @map("subject_id") @db.Uuid
  subjectName   String        @map("subject_name") @db.VarChar(150)
  provider      String        @db.VarChar(50)
  score         Int
  matches       Json
  status        AmlCaseStatus
  reviewedById  String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewRemarks String?       @map("review_remarks") @db.VarChar(1000)
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@index([status])
  @@map("aml_screening")
}

// Watch-list entries used by the built-in screening provider (sanctions / PEP lists loaded by Compliance).
model AmlWatchlistEntry {
  id         String   @id @default(uuid()) @db.Uuid
  listName   String   @map("list_name") @db.VarChar(50)
  fullName   String   @map("full_name") @db.VarChar(150)
  normalised String   @db.VarChar(150)
  idNumber   String?  @map("id_number") @db.VarChar(50)
  country    String?  @db.VarChar(50)
  reference  String?  @db.VarChar(100)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([normalised])
  @@map("aml_watchlist_entry")
}

// ---------------------------------------------------------------------------
// Products, quotations and policies
// ---------------------------------------------------------------------------

model Product {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique @db.VarChar(20)
  name                  String   @db.VarChar(150)
  lineOfBusiness        String   @map("line_of_business") @db.VarChar(50)
  description           String   @db.VarChar(1000)
  ratingEngine          String   @map("rating_engine") @db.VarChar(30)
  config                Json
  requiredDocuments     Json     @map("required_documents")
  questionnaire         Json
  paymentBeforeIssuance Boolean  @default(true) @map("payment_before_issuance")
  allowRenewal          Boolean  @default(true) @map("allow_renewal")
  active                Boolean  @default(true)
  sortOrder             Int      @default(0) @map("sort_order")
  updatedAt             DateTime @updatedAt @map("updated_at")

  policies Policy[]

  @@map("product")
}

model Policy {
  id                    String              @id @default(uuid()) @db.Uuid
  quotationNo           String              @unique @map("quotation_no") @db.VarChar(20)
  policyNo              String?             @unique @map("policy_no") @db.VarChar(20)
  productId             String              @map("product_id") @db.Uuid
  participantId         String              @map("participant_id") @db.Uuid
  agentId               String              @map("agent_id") @db.Uuid
  agencyId              String              @map("agency_id") @db.Uuid
  status                PolicyStatus        @default(DRAFT)
  paymentStatus         PolicyPaymentStatus @default(UNPAID) @map("payment_status")
  planCode              String?             @map("plan_code") @db.VarChar(20)
  coverageType          String?             @map("coverage_type") @db.VarChar(20)
  sumCovered            Decimal             @map("sum_covered") @db.Decimal(14, 2)
  termMonths            Int                 @map("term_months")
  startDate             DateTime?           @map("start_date") @db.Date
  endDate               DateTime?           @map("end_date") @db.Date
  contribution          Decimal             @db.Decimal(14, 2)
  contributionBreakdown Json                @map("contribution_breakdown")
  riskDetails           Json                @map("risk_details")
  questionnaire         Json?
  referralReasons       String[]            @default([]) @map("referral_reasons")
  outstandingAmount     Decimal             @default(0) @map("outstanding_amount") @db.Decimal(14, 2)
  paymentDueDate        DateTime?           @map("payment_due_date") @db.Date
  submittedAt           DateTime?           @map("submitted_at")
  approvedAt            DateTime?           @map("approved_at")
  issuedAt              DateTime?           @map("issued_at")
  rejectedReason        String?             @map("rejected_reason") @db.VarChar(1000)
  cancelledAt           DateTime?           @map("cancelled_at")
  cancellationReason    String?             @map("cancellation_reason") @db.VarChar(1000)
  renewalOfId           String?             @map("renewal_of_id") @db.Uuid
  createdById           String              @map("created_by_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  version               Int                 @default(0)

  product     Product             @relation(fields: [productId], references: [id])
  participant Participant         @relation(fields: [participantId], references: [id])
  agent       Agent               @relation(fields: [agentId], references: [id])
  agency      Agency              @relation(fields: [agencyId], references: [id])
  renewalOf   Policy?             @relation("PolicyRenewal", fields: [renewalOfId], references: [id])
  renewals    Policy[]            @relation("PolicyRenewal")
  nominees    Nominee[]
  events      PolicyEvent[]
  allocations PaymentAllocation[]
  receipts    Receipt[]
  claims      Claim[]
  commissions Commission[]
  signatures  SignatureRequest[]

  @@index([agencyId, status])
  @@index([agentId, status])
  @@index([participantId])
  @@index([status, paymentStatus, paymentDueDate])
  @@index([issuedAt])
  @@map("policy")
}

model Nominee {
  id           String      @id @default(uuid()) @db.Uuid
  policyId     String      @map("policy_id") @db.Uuid
  fullName     String      @map("full_name") @db.VarChar(150)
  idNumberEnc  String?     @map("id_number_enc")
  relationship String      @db.VarChar(50)
  role         NomineeRole @default(NOMINEE)
  sharePercent Decimal     @map("share_percent") @db.Decimal(5, 2)

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("nominee")
}

model PolicyEvent {
  id         String        @id @default(uuid()) @db.Uuid
  policyId   String        @map("policy_id") @db.Uuid
  action     String        @db.VarChar(50)
  fromStatus PolicyStatus? @map("from_status")
  toStatus   PolicyStatus? @map("to_status")
  remarks    String?       @db.VarChar(1000)
  actorId    String?       @map("actor_id") @db.Uuid
  actorName  String?       @map("actor_name") @db.VarChar(150)
  createdAt  DateTime      @default(now()) @map("created_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, createdAt])
  @@map("policy_event")
}

model SignatureRequest {
  id             String    @id @default(uuid()) @db.Uuid
  policyId       String    @map("policy_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  recipientName  String    @map("recipient_name") @db.VarChar(150)
  recipientEmail String    @map("recipient_email") @db.VarChar(254)
  expiresAt      DateTime  @map("expires_at")
  signedAt       DateTime? @map("signed_at")
  signerIp       String?   @map("signer_ip") @db.VarChar(64)
  documentId     String?   @map("document_id") @db.Uuid
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("signature_request")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  paymentNo       String        @unique @map("payment_no") @db.VarChar(20)
  agencyId        String        @map("agency_id") @db.Uuid
  submittedById   String        @map("submitted_by_id") @db.Uuid
  method          PaymentMethod
  bankName        String?       @map("bank_name") @db.VarChar(100)
  referenceNo     String        @map("reference_no") @db.VarChar(50)
  paymentDate     DateTime      @map("payment_date") @db.Date
  totalAmount     Decimal       @map("total_amount") @db.Decimal(14, 2)
  status          PaymentStatus @default(PENDING_VERIFICATION)
  remarks         String?       @db.VarChar(500)
  verifiedById    String?       @map("verified_by_id") @db.Uuid
  verifiedAt      DateTime?     @map("verified_at")
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at")

  agency      Agency              @relation(fields: [agencyId], references: [id])
  allocations PaymentAllocation[]
  receipts    Receipt[]

  @@index([agencyId, status])
  @@index([status, createdAt])
  @@map("payment")
}

model PaymentAllocation {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  policyId  String  @map("policy_id") @db.Uuid
  amount    Decimal @db.Decimal(14, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  policy  Policy  @relation(fields: [policyId], references: [id])

  @@unique([paymentId, policyId])
  @@index([policyId])
  @@map("payment_allocation")
}

model Receipt {
  id         String   @id @default(uuid()) @db.Uuid
  receiptNo  String   @unique @map("receipt_no") @db.VarChar(20)
  paymentId  String   @map("payment_id") @db.Uuid
  policyId   String   @map("policy_id") @db.Uuid
  amount     Decimal  @db.Decimal(14, 2)
  issuedAt   DateTime @default(now()) @map("issued_at")
  documentId String?  @map("document_id") @db.Uuid

  payment Payment @relation(fields: [paymentId], references: [id])
  policy  Policy  @relation(fields: [policyId], references: [id])

  @@index([policyId])
  @@index([issuedAt])
  @@map("receipt")
}

model Commission {
  id           String           @id @default(uuid()) @db.Uuid
  agentId      String           @map("agent_id") @db.Uuid
  policyId     String           @map("policy_id") @db.Uuid
  period       String           @db.VarChar(7)
  contribution Decimal          @db.Decimal(14, 2)
  rate         Decimal          @db.Decimal(6, 4)
  amount       Decimal          @db.Decimal(14, 2)
  status       CommissionStatus @default(ACCRUED)
  paidAt       DateTime?        @map("paid_at")
  source       String           @db.VarChar(20)
  createdAt    DateTime         @default(now()) @map("created_at")

  agent  Agent  @relation(fields: [agentId], references: [id])
  policy Policy @relation(fields: [policyId], references: [id])

  @@unique([policyId, agentId])
  @@index([agentId, period])
  @@map("commission")
}

// ---------------------------------------------------------------------------
// Claims
// ---------------------------------------------------------------------------

model Claim {
  id            String      @id @default(uuid()) @db.Uuid
  claimNo       String      @unique @map("claim_no") @db.VarChar(20)
  policyId      String      @map("policy_id") @db.Uuid
  agentId       String      @map("agent_id") @db.Uuid
  agencyId      String      @map("agency_id") @db.Uuid
  claimType     String      @map("claim_type") @db.VarChar(50)
  eventDate     DateTime    @map("event_date") @db.Date
  description   String      @db.VarChar(2000)
  claimedAmount Decimal?    @map("claimed_amount") @db.Decimal(14, 2)
  status        ClaimStatus @default(SUBMITTED)
  remarks       String?     @db.VarChar(1000)
  submittedById String      @map("submitted_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  policy Policy @relation(fields: [policyId], references: [id])

  @@index([agencyId, status])
  @@index([policyId])
  @@map("claim")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id              String            @id @default(uuid()) @db.Uuid
  ownerType       DocumentOwnerType @map("owner_type")
  ownerId         String            @map("owner_id") @db.Uuid
  docType         String            @map("doc_type") @db.VarChar(50)
  fileName        String            @map("file_name") @db.VarChar(255)
  mimeType        String            @map("mime_type") @db.VarChar(100)
  sizeBytes       Int               @map("size_bytes")
  storageKey      String            @unique @map("storage_key") @db.VarChar(255)
  sha256          String            @db.VarChar(64)
  status          DocumentStatus    @default(UPLOADED)
  expiryDate      DateTime?         @map("expiry_date") @db.Date
  remarks         String?           @db.VarChar(500)
  systemGenerated Boolean           @default(false) @map("system_generated")
  uploadedById    String?           @map("uploaded_by_id") @db.Uuid
  verifiedById    String?           @map("verified_by_id") @db.Uuid
  verifiedAt      DateTime?         @map("verified_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([ownerType, ownerId])
  @@index([status])
  @@map("document")
}

// ---------------------------------------------------------------------------
// Workflow (maker-checker)
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id          String       @id @default(uuid()) @db.Uuid
  type        ApprovalType @unique
  name        String       @db.VarChar(100)
  description String?      @db.VarChar(500)
  active      Boolean      @default(true)
  updatedAt   DateTime     @updatedAt @map("updated_at")

  steps WorkflowStep[]

  @@map("workflow_definition")
}

model WorkflowStep {
  id           String   @id @default(uuid()) @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  level        Int
  name         String   @db.VarChar(100)
  permission   String   @db.VarChar(80)
  minAmount    Decimal? @map("min_amount") @db.Decimal(14, 2)

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, level])
  @@map("workflow_step")
}

model ApprovalRequest {
  id               String         @id @default(uuid()) @db.Uuid
  requestNo        String         @unique @map("request_no") @db.VarChar(20)
  type             ApprovalType
  entityType       String         @map("entity_type") @db.VarChar(30)
  entityId         String         @map("entity_id") @db.Uuid
  summary          String         @db.VarChar(300)
  payload          Json
  amount           Decimal?       @db.Decimal(14, 2)
  status           ApprovalStatus @default(PENDING)
  currentLevel     Int            @default(1) @map("current_level")
  totalLevels      Int            @map("total_levels")
  levelPermissions String[]       @map("level_permissions")
  makerId          String         @map("maker_id") @db.Uuid
  makerName        String         @map("maker_name") @db.VarChar(150)
  agencyId         String?        @map("agency_id") @db.Uuid
  submittedAt      DateTime       @default(now()) @map("submitted_at")
  decidedAt        DateTime?      @map("decided_at")
  finalRemarks     String?        @map("final_remarks") @db.VarChar(1000)

  actions ApprovalAction[]

  @@index([status, type])
  @@index([entityType, entityId])
  @@index([makerId])
  @@map("approval_request")
}

model ApprovalAction {
  id        String             @id @default(uuid()) @db.Uuid
  requestId String             @map("request_id") @db.Uuid
  level     Int
  action    ApprovalActionType
  actorId   String             @map("actor_id") @db.Uuid
  actorName String             @map("actor_name") @db.VarChar(150)
  remarks   String?            @db.VarChar(1000)
  createdAt DateTime           @default(now()) @map("created_at")

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("approval_action")
}

// ---------------------------------------------------------------------------
// Issue management
// ---------------------------------------------------------------------------

model Issue {
  id               String        @id @default(uuid()) @db.Uuid
  issueNo          String        @unique @map("issue_no") @db.VarChar(20)
  title            String        @db.VarChar(200)
  description      String        @db.VarChar(4000)
  category         String        @db.VarChar(50)
  priority         IssuePriority
  status           IssueStatus   @default(OPEN)
  reportedById     String        @map("reported_by_id") @db.Uuid
  reportedByName   String        @map("reported_by_name") @db.VarChar(150)
  agencyId         String?       @map("agency_id") @db.Uuid
  assignedToId     String?       @map("assigned_to_id") @db.Uuid
  assignedToName   String?       @map("assigned_to_name") @db.VarChar(150)
  assignedTeam     String?       @map("assigned_team") @db.VarChar(50)
  responseDueAt    DateTime      @map("response_due_at")
  resolutionDueAt  DateTime      @map("resolution_due_at")
  firstRespondedAt DateTime?     @map("first_responded_at")
  resolvedAt       DateTime?     @map("resolved_at")
  closedAt         DateTime?     @map("closed_at")
  slaBreached      Boolean       @default(false) @map("sla_breached")
  resolution       String?       @db.VarChar(2000)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  comments IssueComment[]

  @@index([status, priority])
  @@index([reportedById])
  @@index([assignedToId])
  @@map("issue")
}

model IssueComment {
  id         String   @id @default(uuid()) @db.Uuid
  issueId    String   @map("issue_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  authorName String   @map("author_name") @db.VarChar(150)
  body       String   @db.VarChar(4000)
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("issue_comment")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  channel   NotificationChannel
  recipient String              @db.VarChar(254)
  eventType String              @map("event_type") @db.VarChar(50)
  subject   String              @db.VarChar(200)
  body      String              @db.VarChar(4000)
  link      String?             @db.VarChar(300)
  attachmentIds String[] @default([]) @map("attachment_ids")
  sensitive     Boolean  @default(false)
  status    DeliveryStatus      @default(PENDING)
  attempts  Int                 @default(0)
  lastError String?             @map("last_error") @db.VarChar(1000)
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, readAt])
  @@index([status, channel])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Audit trail (append-only — enforced by database trigger)
// ---------------------------------------------------------------------------

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  occurredAt    DateTime @default(now()) @map("occurred_at")
  actorId       String?  @map("actor_id") @db.Uuid
  actorName     String?  @map("actor_name") @db.VarChar(150)
  action        String   @db.VarChar(60)
  entityType    String   @map("entity_type") @db.VarChar(40)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  before        Json?
  after         Json?
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(300)
  correlationId String?  @map("correlation_id") @db.VarChar(64)

  @@index([occurredAt])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([action])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Configuration and master data
// ---------------------------------------------------------------------------

model ConfigParameter {
  key         String        @id @db.VarChar(80)
  value       String        @db.VarChar(1000)
  valueType   ParameterType @map("value_type")
  category    String        @db.VarChar(50)
  description String        @db.VarChar(500)
  minValue    Decimal?      @map("min_value") @db.Decimal(14, 2)
  maxValue    Decimal?      @map("max_value") @db.Decimal(14, 2)
  updatedById String?       @map("updated_by_id") @db.Uuid
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("config_parameter")
}

model CodeItem {
  id        String  @id @default(uuid()) @db.Uuid
  category  String  @db.VarChar(50)
  code      String  @db.VarChar(50)
  label     String  @db.VarChar(150)
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  @@unique([category, code])
  @@map("code_item")
}

// ---------------------------------------------------------------------------
// Integration
// ---------------------------------------------------------------------------

model OutboxMessage {
  id            String            @id @default(uuid()) @db.Uuid
  system        IntegrationSystem
  operation     String            @db.VarChar(60)
  payload       Json
  status        OutboxStatus      @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at")
  lastError     String?           @map("last_error") @db.VarChar(1000)
  aggregateType String?           @map("aggregate_type") @db.VarChar(30)
  aggregateId   String?           @map("aggregate_id") @db.VarChar(64)
  correlationId String?           @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime          @default(now()) @map("created_at")
  processedAt   DateTime?         @map("processed_at")

  @@index([status, nextAttemptAt])
  @@index([system, createdAt])
  @@map("outbox_message")
}

model IntegrationLog {
  id              String               @id @default(uuid()) @db.Uuid
  system          IntegrationSystem
  operation       String               @db.VarChar(60)
  direction       IntegrationDirection
  success         Boolean
  durationMs      Int                  @map("duration_ms")
  reference       String?              @db.VarChar(100)
  requestSummary  String?              @map("request_summary") @db.VarChar(1000)
  responseSummary String?              @map("response_summary") @db.VarChar(1000)
  errorMessage    String?              @map("error_message") @db.VarChar(1000)
  outboxId        String?              @map("outbox_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([system, createdAt])
  @@index([success, createdAt])
  @@map("integration_log")
}

model ReconciliationRun {
  id             String               @id @default(uuid()) @db.Uuid
  businessDate   DateTime             @map("business_date") @db.Date
  system         IntegrationSystem
  expectedCount  Int                  @map("expected_count")
  matchedCount   Int                  @map("matched_count")
  expectedAmount Decimal              @map("expected_amount") @db.Decimal(14, 2)
  matchedAmount  Decimal              @map("matched_amount") @db.Decimal(14, 2)
  status         ReconciliationStatus
  details        Json
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([businessDate, system])
  @@map("reconciliation_run")
}

model EodRun {
  id                String    @id @default(uuid()) @db.Uuid
  businessDate      DateTime  @unique @map("business_date") @db.Date
  status            JobStatus
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  policiesIssued    Int       @default(0) @map("policies_issued")
  receiptsIssued    Int       @default(0) @map("receipts_issued")
  totalContribution Decimal   @default(0) @map("total_contribution") @db.Decimal(14, 2)
  totalReceipts     Decimal   @default(0) @map("total_receipts") @db.Decimal(14, 2)
  reportDocumentId  String?   @map("report_document_id") @db.Uuid
  finFileDocumentId String?   @map("fin_file_document_id") @db.Uuid
  errorMessage      String?   @map("error_message") @db.VarChar(1000)
  triggeredBy       String    @map("triggered_by") @db.VarChar(150)

  @@map("eod_run")
}

model ReportSchedule {
  id          String          @id @default(uuid()) @db.Uuid
  reportCode  String          @map("report_code") @db.VarChar(50)
  name        String          @db.VarChar(150)
  frequency   ReportFrequency
  format      ExportFormat
  recipients  String[]
  filters     Json
  active      Boolean         @default(true)
  lastRunAt   DateTime?       @map("last_run_at")
  nextRunAt   DateTime        @map("next_run_at")
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([active, nextRunAt])
  @@map("report_schedule")
}

# SalesVerse 2.0 API configuration. Copy to .env for local development.
# In SIT/UAT/production set these as environment variables or secrets, never in files.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://iift:change-me@127.0.0.1:5432/iift
DATABASE_POOL_SIZE=10
TRUST_PROXY_HOPS=1
PUBLIC_BASE_URL=http://localhost:5173
API_DOCS_ENABLED=true
LOG_LEVEL=info

# Sessions: at least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
SESSION_COOKIE_NAME=iift.sid
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_PER_MINUTE=10

# 256-bit keys, base64 encoded, e.g. `openssl rand -base64 32` (keep in a vault; rotating needs re-encryption)
FIELD_ENCRYPTION_KEY=
FIELD_HASH_KEY=
DOCUMENT_ENCRYPTION_KEY=

# Documents
DOCUMENT_STORAGE_PATH=./storage/documents
MAX_UPLOAD_MB=10
CLAMAV_HOST=
CLAMAV_PORT=3310

# Scheduled jobs (end of day 23:30 Brunei time by default)
JOBS_ENABLED=true
JOBS_TIMEZONE=Asia/Brunei
EOD_CRON=0 30 23 * * *

# Integration: "simulated" until IIFT endpoints are available, then "live"
INTEGRATION_MODE=simulated
INBOUND_API_KEY_SHA256=
CORE_API_BASE_URL=
CORE_API_API_KEY=
FINANCE_API_BASE_URL=
FINANCE_API_API_KEY=
AML_API_BASE_URL=
AML_API_API_KEY=
SMS_API_BASE_URL=
SMS_API_API_KEY=
SMS_SENDER_ID=IIFT

# E-mail (SMTP relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Back-office directory sign-in (Active Directory / LDAP), optional
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(sAMAccountName={{username}})

# Bearer token required by /metrics (recommended outside development)
METRICS_TOKEN=
